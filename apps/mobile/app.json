{
  "expo": {
    "name": "Pentilius",
    "slug": "pentilius",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pentilius.game"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080c11",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pentilius.game"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-localization",
      "./plugins/with-release-signing.js"
    ],
    "scheme": "pentilius",
    "backgroundColor": "#080c11",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://pentilius.com/api/v1",
      "assetBaseUrl": "https://pentilius.com"
    }
  }
}
