// Milestone 1: single-player vertical slice (base, buildings, robot/equipment,
// inventory, zones, PvE, XP/level, loot, item upgrade, battle reports).
// Static definitions vs. player state split per instructions/ARCHITECTURE.md.
//
// Several fields here stand in for values marked UNDEFINED in
// instructions/GAME_SYSTEMS.md / instructions/OPEN_DECISIONS.md (XP curve,
// land unlock thresholds, combat stats, upgrade costs). They are seeded data
// (LevelThreshold, Zone.unlockLevel, BuildingLevelCost, ItemDefinition) or
// constants in src/config/game-config.ts — never hard-coded in game logic —
// so the real values can be tuned later without touching code. See
// instructions/OPEN_DECISIONS.md for the list of what is still placeholder.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EquipmentSlot {
  HEAD
  LEFT_ARM
  RIGHT_ARM
  ARMOR
  CORE
  LEFT_LEG
  RIGHT_LEG
}

enum ResourceType {
  METAL
  CRYSTAL
  CREDITS
}

enum BattleOutcome {
  WIN
  LOSS
}

enum ClanWarStatus {
  ACTIVE
  RESOLVED
}

// How a ClanWar ended (owner decision, 2026-09-10): CONQUEST when a clan's
// warPool hits 0 before the deadline (decisive, bigger reward); DECISION
// when the 3-day deadline passes first and the clan with more remaining pool
// wins (still a real win, smaller reward — deliberately not a draw, so
// there's always a reason to keep fighting until the deadline); DRAW only on
// a true tie (e.g. nobody attacked at all, both pools still full/equal).
enum ClanWarOutcome {
  CONQUEST
  DECISION
  DRAW
}

// Names and lore are LOCKED (instructions/PRODUCT_SPEC.md). Chosen once at
// registration; identity only for now — no stat bonus is tied to race yet
// (instructions/OPEN_DECISIONS.md).
enum Race {
  LUXARI
  VORLUN
  ZARYTH
  THALION
  NEXAR
}

// Named equipment sets (instructions/GAME_SYSTEMS.md): 7 slots each, escalating
// power. Null for CONSUMABLE items.
enum ItemTier {
  PIONEER
  ASCENDANT
  COREFORGED
}

// "Excellent options" quality (instructions/GAME_SYSTEMS.md). NORMAL has no
// bonus option; RARE rolls 1 from ItemInstance.rolledOptions; EPIC (2 options)
// isn't rollable through the normal loot path yet — reserved for a future
// boss box/cache mechanic (instructions/OPEN_DECISIONS.md).
enum ItemQuality {
  NORMAL
  RARE
  EPIC
}

// Bonus stat options rolled onto RARE/EPIC ItemInstances. Pool depends on slot
// category (weapon: LEFT_ARM/RIGHT_ARM: INCREASE_DAMAGE, CRITICAL_DAMAGE; armor:
// every other slot: INCREASE_MAX_HP, DAMAGE_DECREASE, DAMAGE_REFLECT). Fixed
// magnitudes live in game-config.ts's GAME_BALANCE.itemOptionValues.
enum ItemOption {
  INCREASE_DAMAGE
  CRITICAL_DAMAGE
  INCREASE_MAX_HP
  DAMAGE_DECREASE
  DAMAGE_REFLECT
}

model Player {
  id           String   @id @default(uuid())
  email        String   @unique
  // Public in-game identity. The email stays private to the account owner —
  // never exposed to other players — and is reserved for future account
  // verification (instructions/OPEN_DECISIONS.md has no ruling on this yet,
  // so treat it as owner-specified: username is the only cross-player identity).
  username     String   @unique
  passwordHash String
  race         Race
  // Free-text self-description shown on the public profile — the player's
  // own words, distinct from any game-computed stats.
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Set only once the player saves a choice in Settings — null means "no
  // saved preference yet," so the app just leaves them on whatever locale
  // they're already viewing instead of forcing one.
  preferredLocale String?

  level Int @default(1)
  xp    Int @default(0)

  // Starting amounts are placeholders (instructions/OPEN_DECISIONS.md: "final resource list").
  metal              Int      @default(500)
  crystal            Int      @default(100)
  credits            Int      @default(50)
  resourcesUpdatedAt DateTime @default(now())

  // 10 is instructions/GAME_SYSTEMS.md's own example standard max, not an invented value.
  actionEnergy    Int      @default(10)
  actionEnergyMax Int      @default(10)
  energyUpdatedAt DateTime @default(now())

  // Touched (throttled) on every authenticated request by JwtStrategy — no
  // real-time presence system, just "was this player active recently" for
  // the clan roster's On liniya / "last seen" display.
  lastActiveAt DateTime @default(now())

  // Revenge-protection window granted after losing a PvP defense, so a freshly
  // raided player cannot be immediately farmed again — instructions/OPEN_DECISIONS.md's
  // "protected resources" / anti-harassment requirement is UNDEFINED in exact
  // shape; this is the placeholder mechanism. Null when not protected.
  pvpProtectedUntil DateTime?

  // Same idea as pvpProtectedUntil above, but for clan-war duels specifically
  // (GAME_BALANCE.clanWar.targetProtectionMinutes) — kept as its own field so
  // the two systems' protection windows can be tuned independently.
  clanWarProtectedUntil DateTime?

  // Shared rolling 24h cooldown covering BOTH creating a new Boss Formation
  // AND joining an existing one — one formation-related action per rolling
  // day, not two independent limits (owner decision, 2026-09-11). Same
  // timestamp-cooldown shape as pvpProtectedUntil/clanWarProtectedUntil above.
  nextBossFormationActionAt DateTime?

  // Anti-flood gap between two Core attacks (GAME_BALANCE.core.attackCooldownSeconds).
  lastCoreAttackAt DateTime?

  // Set automatically when too many of this player's reports get dismissed
  // (GAME_BALANCE.moderation) — they can't file new reports until it passes.
  reportingSuspendedUntil DateTime?

  // Account deletion (owner decision, 2026-10-12 — app-store requirement).
  // Requesting deletion (password + a one-time code shown on screen) sets
  // deletionScheduledFor = now + GameSettings.accountDeletionGraceDays; the
  // player can keep playing and cancel until then. A background job
  // (account-deletion.service.ts) then anonymizes the account: personal data
  // is wiped, the username becomes a "~deleted~…" marker (shown translated as
  // "Deleted player"), and deletedAt is set. The row itself stays so every
  // history record (battles, wars, market, Core points, donations) keeps working.
  deletionScheduledFor DateTime?
  deletedAt            DateTime?

  // Set for everyone by a season reset (owner decision, 2026-10-13): race is
  // re-chosen every season, so the player must pick one (POST
  // /player/me/race) before playing on. Cleared once they choose.
  needsRaceSelection Boolean @default(false)

  // When the player accepted the Rules and Privacy Policy (and confirmed the
  // minimum age) at registration — evidence in case of a dispute. Null for
  // accounts created before the checkbox existed (2026-10-12).
  termsAcceptedAt DateTime?

  // Reactor bonus, kept on the player so energy settling needs no extra query
  // (updated when a Reactor level finishes). Fraction off the regen interval.
  energyRegenBonus Float @default(0)

  // Exchange daily usage (owner decision, 2026-10-14) — day in Europe/Sofia.
  exchangeDay        String?
  exchangeUsedToday  Int     @default(0)
  // Daily-task streak (owner decision, 2026-10-14): days with every daily task
  // done, misses used in this series, the last completed day, and whether
  // the reward is waiting. See DailyTasksService.
  dailyStreakDays    Int     @default(0)
  dailyStreakMisses  Int     @default(0)
  dailyStreakLastDay String?
  dailyStreakReady   Boolean @default(false)

  // Email confirmation (owner decision, 2026-10-13) — optional; null until the
  // player opens the emailed link (or resets the password via email).
  emailVerifiedAt DateTime?

  // VIP (owner decision, 2026-10-13): VIP while now < vipUntil. Granted from
  // godmaster for now; a future payment flow will extend the same date. VIP
  // only adds convenience (auto-claimed daily rewards, "Attack x3", a
  // one-slot build queue) and a chat name colour — never combat power.
  vipUntil DateTime?

  // VIP build queue: one building that starts by itself when the current
  // construction ends. Its cost is paid when queued (stored here so a cancel
  // refunds exactly what was paid). Plain id, not a relation — at most one row.
  buildQueueBuildingTypeId String?
  buildQueueMetal          Int       @default(0)
  buildQueueCrystal        Int       @default(0)
  deletionCode             String?
  deletionCodeExpiresAt    DateTime?

  // Admin-issued suspension (godmaster panel) — null means not banned. Login
  // rejects with the remaining time while now < bannedUntil; the ban simply
  // expires on its own afterward, no separate "unban" state to clean up
  // (same lapses-on-its-own shape as pvpProtectedUntil above). banReason is
  // shown to the banned player on the login screen.
  bannedUntil DateTime?
  banReason   String?

  // "Core Attributes" — personal stat points earned from leveling
  // (instructions/GAME_SYSTEMS.md has no prior ruling on this; it's a new
  // system introduced alongside the ship→robot redesign). Owner decision
  // (2026-09-09): new accounts start with 0 unspent points — no starting
  // freebie — and earn points only by leveling (GAME_BALANCE.robotAttributes.
  // basePointsPerLevel, currently a flat 3/level). Previously defaulted to 20.
  // Pure point-buy: no resource cost, no respec yet (instructions/OPEN_DECISIONS.md-style
  // placeholder for everything else about this system).
  attributePointsAvailable Int @default(0)
  baseDamage               Int @default(0)
  baseDefense              Int @default(0)
  baseHp                   Int @default(0)
  // Tracked and spendable now; has no effect on combat until evasion is
  // wired into the formula in a later phase.
  baseEvasion              Int @default(0)
  // Free resets of the points above: every spent point comes back to spend
  // again (owner decision, 2026-10-20 — one for everyone when the combat
  // formula changes, so points spent under the old rules can be moved).
  attributeRespecs         Int @default(0)

  // Cosmetic profile picture — shown above everything on the Robot page and
  // on the public profile. Loose key references (not a relation) — validated
  // against AvatarDefinition/FrameDefinition.key at write time, same style as
  // other key-based references in this schema. Defaults to avatar1/frame1
  // (owner decision, 2026-09-09) rather than nothing — still just a starting
  // pick, freely replaceable in Settings. All 6 initial avatars/frames are
  // free to pick for now — some may require unlocking later, not built yet.
  selectedAvatarKey String @default("avatar1")
  selectedFrameKey  String @default("frame1")

  buildings                PlayerBuilding[]
  items                    ItemInstance[]
  battleReports            BattleReport[]
  expeditions              PlayerExpedition[]
  researches               PlayerResearch[]
  bossFormationsCreated    BossFormation[]            @relation("BossFormationsCreated")
  bossFormationSlots       BossFormationSlot[]
  bossFormationDailyPoints BossFormationDailyPoints[]
  pvpAttacks               PvpBattleReport[]          @relation("PvpAttacks")
  pvpDefenses              PvpBattleReport[]          @relation("PvpDefenses")
  clanWarAttacksSent       ClanWarAttack[]            @relation("ClanWarAttacksAsAttacker")
  clanWarAttacksReceived   ClanWarAttack[]            @relation("ClanWarAttacksAsDefender")
  clanMembership           ClanMembership?
  clanMessages             ClanMessage[]
  friendRequestsSent       Friendship[]               @relation("FriendRequestsSent")
  friendRequestsReceived   Friendship[]               @relation("FriendRequestsReceived")
  directMessagesSent       DirectMessage[]            @relation("DirectMessagesSent")
  directMessagesReceived   DirectMessage[]            @relation("DirectMessagesReceived")
  marketListingsSold       MarketListing[]            @relation("MarketListingsSold")
  marketListingsBought     MarketListing[]            @relation("MarketListingsBought")
  adminActionLogs          AdminActionLog[]
  coreAttacks              CoreAttack[]
  seasonResults            SeasonPlayerResult[]
  dailyTaskProgress        DailyTaskProgress[]
  dailyTaskClaims          DailyTaskClaim[]
  achievementProgress      AchievementProgress[]
  achievementClaims        AchievementClaim[]
  supportTickets           SupportTicket[]
  announcementDismissals   AnnouncementDismissal[]
  pushSubscriptions        PushSubscription[]
  purchases                Purchase[]
  pushDispatches           PushDispatch[]
  loginEvents              LoginEvent[]
  emailTokens              EmailToken[]

  // Which notifications the player wants (owner decision, 2026-10-13) —
  // { TYPE: false } switches one off; missing = on. Shared by every channel.
  notificationSettings Json           @default("{}")
  blocksMade           PlayerBlock[]  @relation("BlocksMade")
  blocksReceived       PlayerBlock[]  @relation("BlocksReceived")
  reportsFiled         PlayerReport[] @relation("ReportsFiled")
  reportsReceived      PlayerReport[] @relation("ReportsReceived")
  identityChanges      PlayerIdentityChange[]

  @@map("players")
}

enum IdentityChangeKind {
  NAME
  RACE
}

// Name and race changes (owner decision, 2026-10-27): bought by the player in
// Settings, or a name changed by staff in godmaster (adminUsername set, free,
// no waiting time). Seen only by staff. Also where the waiting time between
// paid changes and the old-name reservation are read from. The race picked at
// the start of a season is not a change and is not recorded here.
model PlayerIdentityChange {
  id            String             @id @default(uuid())
  playerId      String
  kind          IdentityChangeKind
  oldValue      String
  newValue      String
  creditsPaid   Int                @default(0)
  adminUsername String?
  createdAt     DateTime           @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, kind, createdAt])
  @@index([kind, createdAt])
  @@map("player_identity_changes")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Friends list (owner decision, 2026-09-09) — step one toward friends-only
// messaging later; deliberately no messaging model yet. One row per pair,
// direction-agnostic once ACCEPTED — @@unique only blocks an exact duplicate
// resend in the same direction, so the service layer must also check the
// reverse direction before creating a new request.
model Friendship {
  id                  String           @id @default(uuid())
  requesterId         String
  addresseeId         String
  status              FriendshipStatus @default(PENDING)
  createdAt           DateTime         @default(now())
  // Owner decision (2026-09-11): powers both the friends-list sort ("most
  // recent conversation first") and the unread indicator, without per-message
  // read receipts. lastMessageAt is set on every sendMessage() regardless of
  // sender — a single shared "when did this conversation last move" marker.
  // requesterLastReadAt/addresseeLastReadAt are each side's own "I opened
  // this conversation" marker, set when that player views it. Unread for a
  // given viewer = lastMessageAt > their own side's lastReadAt.
  lastMessageAt       DateTime?
  requesterLastReadAt DateTime?
  addresseeLastReadAt DateTime?

  requester Player @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee Player @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

// 1:1 messaging, friends-only (owner decision, 2026-09-10) — mutual consent
// via Friendship is what makes this safe from the unwanted-message problem
// that ruled out an open chat earlier. Same limits as ClanMessage
// (GAME_BALANCE.directMessages, kept as its own tunable block even though the
// values currently match), plain text only, no formatting/attachments/edit/delete.
model DirectMessage {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  text        String
  createdAt   DateTime @default(now())

  sender    Player @relation("DirectMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient Player @relation("DirectMessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("direct_messages")
}

// Selectable profile-picture cosmetics (owner decision, 2026-09-09) — a
// player picks one of each, shown layered (avatar under frame, both drawn on
// the same fixed canvas so they align without per-image scaling — see
// apps/web/public/assets/avatars/ and .../frames/). Referenced from Player by
// key, not id — see Player.selectedAvatarKey/selectedFrameKey.
model AvatarDefinition {
  id          String @id @default(uuid())
  key         String @unique
  nameKey     String
  iconAssetId String

  @@map("avatar_definitions")
}

model FrameDefinition {
  id          String @id @default(uuid())
  key         String @unique
  nameKey     String
  iconAssetId String

  @@map("frame_definitions")
}

model Zone {
  id          String @id @default(uuid())
  key         String @unique
  nameKey     String
  order       Int
  unlockLevel Int
  // Landscape thumbnail shown on the /zones list (owner decision) — unlike
  // item/race/Pentili icons (square, transparent), this is a full landscape
  // scene, no transparency needed. See apps/web/public/assets/zones/.
  iconAssetId String

  pentili       Pentili[]
  battleReports BattleReport[]
  bosses        Boss[]

  @@map("zones")
}

model Pentili {
  id                String  @id @default(uuid())
  key               String  @unique
  nameKey           String
  zoneId            String
  level             Int
  maxHp             Int
  attack            Int
  defense           Int
  xpReward          Int
  iconAssetId       String
  // Pentili balance from godmaster (owner decision, 2026-10-18). Stats, XP
  // and loot are generated from the curves in BalanceConfig "pentili"
  // (src/config/pentili-balance.ts); only these few things are per Pentili:
  // its place in the zone (level = zone start + place × zone step), an
  // optional fixed level, a strength multiplier (rewards follow it), and an
  // optional special drop.
  orderInZone       Int     @default(0)
  levelOverride     Int?
  strength          Float   @default(1)
  specialItemKey    String?
  specialItemChance Float?

  zone          Zone           @relation(fields: [zoneId], references: [id])
  lootDrops     LootDrop[]
  battleReports BattleReport[]

  @@map("pentili")
}

model LootDrop {
  id               String        @id @default(uuid())
  pentiliId        String
  resourceType     ResourceType?
  itemDefinitionId String?
  dropChance       Float
  minQuantity      Int
  maxQuantity      Int

  pentili        Pentili         @relation(fields: [pentiliId], references: [id])
  itemDefinition ItemDefinition? @relation(fields: [itemDefinitionId], references: [id])

  @@map("loot_drops")
}

model BuildingType {
  id                      String @id @default(uuid())
  key                     String @unique
  nameKey                 String
  maxLevel                Int
  iconAssetId             String
  // Only the Warehouse sets this (owner decision: Warehouse raises personal
  // inventory capacity — it previously had no coded effect at all). Null/0
  // for every other building. Mirrors ClanBuildingType.bonusPerLevel's flat
  // per-level pattern, scoped to the one building that needs it.
  capacityBonusPerLevel   Int?
  // Only the Trading Post sets this (owner decision, 2026-09-11: Market
  // listing capacity is a building, not a research — same "buildings =
  // capacity, research = % bonuses" split as the Warehouse above). Base
  // Market capacity is 0 — a player can't list anything until this reaches
  // level 1. A fraction since 2026-10-14 (0.5 = one listing every 2 levels,
  // rounded up — see src/base/building-effects.ts).
  marketSlotBonusPerLevel Float?
  // Only the Defense System sets this (owner decision, 2026-10-12): +defense
  // fraction per level (0.01 = +1%/level), applied ONLY while this player is
  // the one being attacked (PvP / clan-war defender) — never on their own
  // attacks. See CombatService.computeCombatBreakdown's `defending` option.
  defenseBonusPerLevel    Float?

  // Research Center (owner decision, 2026-10-14): researches can't go above
  // level * this. Its first levels also unlock the longer expeditions
  // (ExpeditionType.requiredNavigationLevel) — moved to the Navigation research on 2026-10-14.
  researchCapPerLevel Int?

  // Reactor (owner decision, 2026-10-14): faster Action Energy regeneration
  // (fraction per level) and +1 max energy every maxEnergyBonusEvery levels.
  energyRegenBonusPerLevel Float?
  maxEnergyBonusEvery      Int?

  // Exchange (owner decision, 2026-10-14): Metal <-> Crystal; the daily limit
  // (input amount) grows by this per level. Rate/fee: GAME_BALANCE.exchange.
  exchangeLimitPerLevel        Int?
  // Only the Defensive Wall sets this (owner decision, 2026-10-12): extra
  // minutes per level added to the regular-PvP revenge protection a player
  // gets after LOSING a defense (GAME_BALANCE.pvp.revengeProtectionMinutes).
  // Regular PvP only — clan-war protection is unaffected on purpose.
  pvpProtectionMinutesPerLevel Int?
  // Only the Hideout sets these (owner decision, 2026-10-12): this much of
  // each resource per level can't be stolen when the player loses a defense
  // (PvP and clan-war duels) — steals are taken from the amount above it.
  protectedMetalPerLevel       Int?
  protectedCrystalPerLevel     Int?
  protectedCreditsPerLevel     Int?

  levelCosts      BuildingLevelCost[]
  playerBuildings PlayerBuilding[]

  @@map("building_types")
}

model BuildingLevelCost {
  id                   String        @id @default(uuid())
  buildingTypeId       String
  level                Int
  metalCost            Int
  crystalCost          Int
  constructionSeconds  Int
  producesResourceType ResourceType?
  producesPerHour      Int?

  buildingType BuildingType @relation(fields: [buildingTypeId], references: [id])

  @@unique([buildingTypeId, level])
  @@map("building_level_costs")
}

// General inventory (owner decision): the catalog isn't robot-equipment-only
// — CONSUMABLE items (starting with Energy Packs) have no slot and stack in
// one ItemInstance row per player via ItemInstance.quantity, instead of one
// row per physical item like EQUIPMENT does.
enum ItemCategory {
  EQUIPMENT
  CONSUMABLE
}

model ItemDefinition {
  id              String         @id @default(uuid())
  key             String         @unique
  nameKey         String
  descriptionKey  String
  // Null for CONSUMABLE items — they have no equipment slot.
  slot            EquipmentSlot?
  category        ItemCategory   @default(EQUIPMENT)
  // Flexible bag, not fixed columns: exact stat schema is UNDEFINED
  // (instructions/OPEN_DECISIONS.md: "final slot list"). EQUIPMENT reads
  // attack/defense/hp keys from it (see pve/combat.service.ts); CONSUMABLE
  // reads an `energy` key instead (see inventory/inventory.service.ts).
  baseStats       Json
  maxUpgradeLevel Int
  iconAssetId     String
  // Reserved for a possible future fixed-race item TYPE (a definition that is
  // always restricted to one race) — distinct from and unrelated to
  // ItemInstance.race below, which is how Coreforged race-locking actually
  // ships. Every seeded item leaves this null (universal).
  race            Race?
  // For EQUIPMENT, which named set this is. Also set on the 3 tier-specific
  // Upgrade-material CONSUMABLEs (see seed.ts) to say which set's gear they
  // upgrade — null only for consumables that aren't upgrade materials.
  tier            ItemTier?

  // System Shop (owner decision, not in GAME_SYSTEMS.md's Trading/auction, which
  // stays the separate future player-to-player mechanic). Only items with
  // inShop are sold (owner decision, 2026-10-20: the Pioneer set at first;
  // the owner picks the rest). A price of 0 means "not required for this item".
  // The seed never overwrites inShop or the prices of an existing item.
  inShop           Boolean @default(false)
  shopPriceMetal   Int @default(0)
  shopPriceCrystal Int @default(0)
  shopPriceCredits Int @default(0)

  itemInstances          ItemInstance[]
  lootDrops              LootDrop[]
  bossLootDrops          BossLootDrop[]
  expeditionTypes        ExpeditionType[]
  guaranteedBoxForBosses Boss[]

  @@map("item_definitions")
}

model LevelThreshold {
  level      Int @id
  xpRequired Int

  @@map("level_thresholds")
}

model PlayerBuilding {
  id                    String    @id @default(uuid())
  playerId              String
  buildingTypeId        String
  level                 Int       @default(0)
  constructionEndsAt    DateTime?
  // When the current construction started — for progress bars (2026-10-14).
  // Null for constructions started before this existed.
  constructionStartedAt DateTime?

  player       Player       @relation(fields: [playerId], references: [id])
  buildingType BuildingType @relation(fields: [buildingTypeId], references: [id])

  @@unique([playerId, buildingTypeId])
  @@map("player_buildings")
}

model ItemInstance {
  id               String         @id @default(uuid())
  playerId         String
  itemDefinitionId String
  upgradeLevel     Int            @default(0)
  equippedSlot     EquipmentSlot?
  // Stack size — always 1 for EQUIPMENT (each instance is a distinct physical
  // item with its own upgrade level); a CONSUMABLE stacks multiple pickups
  // of the same ItemDefinition into one row instead of one row each.
  quantity         Int            @default(1)
  // Excellent-option quality rolled at grant time (inventory-capacity.ts's
  // grantItem) — NORMAL/RARE only today; see ItemQuality.
  quality          ItemQuality    @default(NORMAL)
  rolledOptions    ItemOption[]   @default([])
  // Set only for COREFORGED-tier drops (one of the 5 races, chosen at grant
  // time) — the specific dropped instance can only be equipped by a player of
  // that race. Null for every other tier/consumable. Distinct from the
  // separate, unused ItemDefinition.race above.
  race             Race?
  acquiredAt       DateTime       @default(now())
  // Set while an ACTIVE MarketListing exists for this instance — equip/sell/
  // recycle/upgrade all check this so a listed item can't be touched out from
  // under a pending sale. Not a relation/unique constraint on purpose: it's
  // one flag to check everywhere else, not a second source of truth to join.
  listedForSale    Boolean        @default(false)

  player         Player          @relation(fields: [playerId], references: [id])
  itemDefinition ItemDefinition  @relation(fields: [itemDefinitionId], references: [id])
  marketListings MarketListing[]

  @@map("item_instances")
}

enum MarketListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

// Player-to-player market (owner decision, 2026-09-10) — the LOCKED "Trading
// and auction" direction from instructions/GAME_SYSTEMS.md, finally built.
// Owner-specified: no listing fee, listings never expire (only removed by
// sale or cancellation), max concurrent ACTIVE listings per player is
// GAME_BALANCE.market.maxActiveListingsPerPlayer. Equipment only for now
// (quantity always 1, no stack-splitting) — consumables may follow later.
// The only anti-self-trading guard right now is buyerId !== sellerId,
// enforced in the service — IP/device heuristics were discussed and
// deliberately deferred.
model MarketListing {
  id                   String              @id @default(uuid())
  sellerId             String
  itemInstanceId       String
  priceMetal           Int                 @default(0)
  priceCrystal         Int                 @default(0)
  priceCredits         Int                 @default(0)
  status               MarketListingStatus @default(ACTIVE)
  createdAt            DateTime            @default(now())
  resolvedAt           DateTime?
  buyerId              String?
  // Visibility restriction (owner decision, 2026-09-10) — both false (default)
  // means public, same as before. When either is set, the listing is hidden
  // entirely from everyone else's browse view, not just unbuyable. Checking
  // BOTH means visible to clanmates OR friends (union), not an intersection.
  // Membership/friendship is checked live at browse time, not snapshotted.
  visibleToClanOnly    Boolean             @default(false)
  visibleToFriendsOnly Boolean             @default(false)

  seller       Player       @relation("MarketListingsSold", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer        Player?      @relation("MarketListingsBought", fields: [buyerId], references: [id], onDelete: SetNull)
  itemInstance ItemInstance @relation(fields: [itemInstanceId], references: [id], onDelete: Cascade)

  @@map("market_listings")
}

model BattleReport {
  id           String        @id @default(uuid())
  playerId     String
  pentiliId    String
  zoneId       String
  outcome      BattleOutcome
  xpGained     Int
  lootSummary  Json
  // Items won but not given because the inventory was full (owner decision, 2026-10-20) —
  // kept apart from lootSummary so older clients never show them as received.
  lostLoot     Json?
  damageDealt  Int
  damageTaken  Int
  rounds       Json
  playerMaxHp  Int
  pentiliMaxHp Int
  createdAt    DateTime      @default(now())

  player  Player  @relation(fields: [playerId], references: [id])
  pentili Pentili @relation(fields: [pentiliId], references: [id])
  zone    Zone    @relation(fields: [zoneId], references: [id])

  @@map("battle_reports")
}

// Durations and rewards are PROVISIONAL (instructions/GAME_SYSTEMS.md:
// "Timed automatic missions such as 1h/5h/10h... Exact values are
// UNDEFINED"). 60/300/600 minutes are the doc's own example, not invented.
model ExpeditionType {
  id                      String  @id @default(uuid())
  key                     String  @unique
  nameKey                 String
  durationMinutes         Int
  metalReward             Int
  crystalReward           Int
  creditsReward           Int
  xpReward                Int
  bonusItemDefinitionId   String?
  bonusItemChance         Float?
  // Research Center level needed to start it (owner decision, 2026-10-14).
  // Longer expeditions unlock at the Navigation research's first levels (owner decision, 2026-10-14).
  requiredNavigationLevel Int     @default(0)

  bonusItemDefinition ItemDefinition?    @relation(fields: [bonusItemDefinitionId], references: [id])
  playerExpeditions   PlayerExpedition[]

  @@map("expedition_types")
}

model PlayerExpedition {
  id               String    @id @default(uuid())
  playerId         String
  expeditionTypeId String
  startedAt        DateTime  @default(now())
  endsAt           DateTime
  claimedAt        DateTime?
  cancelled        Boolean   @default(false)

  player         Player         @relation(fields: [playerId], references: [id])
  expeditionType ExpeditionType @relation(fields: [expeditionTypeId], references: [id])

  @@map("player_expeditions")
}

// Branches, technology list, costs and effects are UNDEFINED
// (instructions/OPEN_DECISIONS.md: "Research"). This is a working mechanism
// with placeholder content, mirroring the building-upgrade pattern — each
// technology has its own independent timer, several can research in
// parallel. Bonuses are applied where noted: EconomyService.settleResources
// (production types) and CombatService.computePlayerStats (combat types).
enum ResearchBonusType {
  METAL_PRODUCTION
  CRYSTAL_PRODUCTION
  COMBAT_ATTACK
  COMBAT_HP
  // Owner decision, 2026-10-14:
  CONSTRUCTION_SPEED
  RESEARCH_SPEED
  EXPEDITION_REWARDS
  UPGRADE_MATERIALS
  RECYCLING
}

model ResearchType {
  id             String            @id @default(uuid())
  key            String            @unique
  nameKey        String
  descriptionKey String
  bonusType      ResearchBonusType
  bonusPerLevel  Float
  maxLevel       Int
  iconAssetId    String

  levelCosts       ResearchLevelCost[]
  playerResearches PlayerResearch[]

  @@map("research_types")
}

model ResearchLevelCost {
  id              String @id @default(uuid())
  researchTypeId  String
  level           Int
  metalCost       Int
  crystalCost     Int
  creditsCost     Int
  researchSeconds Int

  researchType ResearchType @relation(fields: [researchTypeId], references: [id])

  @@unique([researchTypeId, level])
  @@map("research_level_costs")
}

model PlayerResearch {
  id                String    @id @default(uuid())
  playerId          String
  researchTypeId    String
  level             Int       @default(0)
  researchEndsAt    DateTime?
  // When the current research started — for progress bars (2026-10-14).
  researchStartedAt DateTime?

  player       Player       @relation(fields: [playerId], references: [id])
  researchType ResearchType @relation(fields: [researchTypeId], references: [id])

  @@unique([playerId, researchTypeId])
  @@map("player_researches")
}

// Boss Formations (owner decision, 2026-09-11 — fully replaces the old open-
// lobby Boss Hunts model; see the project_boss_formations.md design memory
// for the full discussion). A formation is a squad of exactly 5 hard
// race-locked slots built against one boss. Multiple OPEN formations can
// coexist for the same boss (e.g. public + clan-only + friends-only in
// parallel) — visibility differentiates who can see/join which, it isn't a
// cap on concurrent attempts. No contribution-weighted rewards: every
// participant of a WINNING formation gets the same XP share, the same
// guaranteed box, and the formation's full damage total credited to their
// own daily leaderboard points — regardless of individual stat contribution.
// A loss gives nothing. Resolution is lazy (checked on next read), same as
// buildings/research/expeditions — no cron, no early-resolve action.
enum BossFormationStatus {
  OPEN
  RESOLVED
}

model Boss {
  id                            String @id @default(uuid())
  key                           String @unique
  nameKey                       String
  zoneId                        String
  level                         Int
  // Minimum player level to create/join a formation against this boss.
  // Owner decision (2026-10-11): per-boss (30/50/70/90, one per zone's own
  // boss) replacing the old flat GAME_BALANCE.bossFormations.minLevel that
  // applied the same threshold to all 4 bosses regardless of difficulty.
  minLevel                      Int
  maxHp                         Int
  attack                        Int
  defense                       Int
  xpReward                      Int
  iconAssetId                   String
  // Guaranteed, non-chance reward for every winning formation participant —
  // schema FK (not a game-config.ts mapping), mirroring how every other
  // "which item does X grant" relationship in this codebase already lives on
  // the content row itself (BossLootDrop.itemDefinitionId, ExpeditionType.
  // bonusItemDefinitionId). Tier-matched to the boss's own zone tier
  // (pioneer_box/ascendant_box/coreforged_box) — see seed.ts.
  guaranteedBoxItemDefinitionId String

  zone              Zone            @relation(fields: [zoneId], references: [id])
  guaranteedBoxItem ItemDefinition  @relation(fields: [guaranteedBoxItemDefinitionId], references: [id])
  lootDrops         BossLootDrop[]
  formations        BossFormation[]

  @@map("bosses")
}

model BossLootDrop {
  id               String        @id @default(uuid())
  bossId           String
  resourceType     ResourceType?
  itemDefinitionId String?
  dropChance       Float
  minQuantity      Int
  maxQuantity      Int

  boss           Boss            @relation(fields: [bossId], references: [id])
  itemDefinition ItemDefinition? @relation(fields: [itemDefinitionId], references: [id])

  @@map("boss_loot_drops")
}

model BossFormation {
  id         String              @id @default(uuid())
  bossId     String
  creatorId  String
  status     BossFormationStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  // createdAt + GAME_BALANCE.bossFormations.enrollmentWindowHours, snapshotted at creation.
  resolvesAt DateTime

  // Same boolean-union semantics as MarketListing.visibleToClanOnly/
  // visibleToFriendsOnly (both false = public; either true = visible to that
  // pool; both true = union, not intersection). Editable by the creator only
  // during the first GAME_BALANCE.bossFormations.visibilityEditWindowHours of
  // the enrollment window — re-checked live (not snapshotted) at browse AND
  // join time, exactly like MarketListing.
  visibleToClanOnly    Boolean @default(false)
  visibleToFriendsOnly Boolean @default(false)

  outcome          BattleOutcome?
  rounds           Json?
  partyMaxHp       Int?
  bossMaxHp        Int?
  // combat.simulate()'s damageDealt, snapshotted once on a WIN — credited in
  // full to every winning participant's BossFormationDailyPoints (not divided).
  totalDamageDealt Int?

  boss    Boss                @relation(fields: [bossId], references: [id])
  creator Player              @relation("BossFormationsCreated", fields: [creatorId], references: [id])
  slots   BossFormationSlot[]

  // The once-a-minute check for formations whose time is up (owner decision, 2026-10-27).
  @@index([status, resolvesAt])
  @@map("boss_formations")
}

// One row per Race per formation, created eagerly (all 5) at formation
// creation time — not created sparsely on join. Makes "join my race's slot"
// a single concurrency-safe compare-and-swap UPDATE (WHERE race=X AND
// playerId IS NULL), and makes "how many slots are filled" a trivial filter.
model BossFormationSlot {
  id          String    @id @default(uuid())
  formationId String
  race        Race
  playerId    String?
  joinedAt    DateTime?
  xpGained    Int?
  lootSummary Json?
  // Items won but not given because the inventory was full (owner decision, 2026-10-20) —
  // kept apart from lootSummary so older clients never show them as received.
  lostLoot    Json?

  formation BossFormation @relation(fields: [formationId], references: [id])
  player    Player?       @relation(fields: [playerId], references: [id])

  @@unique([formationId, race])
  @@map("boss_formation_slots")
}

// Per-account, per-UTC-calendar-day point accumulator — a SEPARATE clock
// from Player.nextBossFormationActionAt (that's the personal rolling 24h
// action cooldown; this is a fixed 00:00 UTC bucket used only for a future
// ranking/reward-tier payout, not gating any action). No leaderboard UI yet
// — this table just gives a future ranking feature something to read.
model BossFormationDailyPoints {
  id       String   @id @default(uuid())
  playerId String
  dateUtc  DateTime // always midnight UTC of the day earned
  points   Int      @default(0)

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, dateUtc])
  @@map("boss_formation_daily_points")
}

// PvP (instructions/GAME_SYSTEMS.md, LOCKED direction: PvP exists, no
// world-map coordinates, matchmaking + anti-harassment protection required).
// Exact power range, cooldowns, defender losses, protected resources, online
// defense bonus, PvP cost and ranking formula are all UNDEFINED
// (instructions/OPEN_DECISIONS.md) — this is a working M3 foundation with
// owner-specified rules (level 5 gate on both sides) and clearly-isolated
// placeholders for the rest: a random-opponent matchmaker (clan-filtered
// targeting waits for Milestone 4), a flat resource-steal percentage on
// defeat, a per-attacker/defender cooldown, and a short revenge-protection
// window for a player who just lost a defense (Player.pvpProtectedUntil).
model PvpBattleReport {
  id            String        @id @default(uuid())
  attackerId    String
  defenderId    String
  outcome       BattleOutcome
  rounds        Json
  attackerMaxHp Int
  defenderMaxHp Int
  damageDealt   Int
  damageTaken   Int
  lootSummary   Json
  createdAt     DateTime      @default(now())

  attacker Player @relation("PvpAttacks", fields: [attackerId], references: [id])
  defender Player @relation("PvpDefenses", fields: [defenderId], references: [id])

  @@map("pvp_battle_reports")
}

// Clans (instructions/GAME_SYSTEMS.md, LOCKED: "Clans are central"). Member
// cap, roles, clan building list, contribution rules and clan-war rules are
// all UNDEFINED (instructions/OPEN_DECISIONS.md) — this is an M4 foundation:
// create/join/leave/roles, plus a shared treasury (donate-only by owner
// decision — any member may donate; nobody can withdraw, the treasury only
// funds clan building upgrades). Clan buildings (Member Hall/Clan Forge/Clan
// Depot) are built on top of the treasury; clan-scoped boss hunts and
// clan-vs-clan systems are deliberately deferred to a later pass, not
// modeled here yet. Joining is open (owner decision, mirroring the Boss
// Hunts precedent) rather than invite/request based — no separate
// invite/request model exists. A leader/officer can still narrow who's
// eligible via automatic join requirements (Clan.joinMinLevel/etc. below,
// owner decision 2026-09-10) — that's a self-service eligibility filter
// applied at join time, not a manual approval step.
enum ClanRole {
  LEADER
  OFFICER
  MEMBER
}

model Clan {
  id          String   @id @default(uuid())
  name        String   @unique
  tag         String   @unique
  description String?
  // Base cap before any Member Hall bonus (owner-specified: 10). The
  // effective cap (exposed to clients) adds the clan's Member Hall level ×
  // its bonusPerLevel (2 slots/level, up to level 10) on top of this. Only
  // affects newly created clans — existing clans keep whatever base they
  // were created with.
  memberCap   Int      @default(10)
  createdAt   DateTime @default(now())

  // Shared clan resource pool. Only the three ResourceType values (Metal/
  // Crystal/Credits — the same ones poolable in PvP, pvp/pvp.service.ts) are
  // treasury-eligible; tier-specific Upgrade materials stay personal-only.
  treasuryMetal   Int @default(0)
  treasuryCrystal Int @default(0)
  treasuryCredits Int @default(0)

  // Join requirements (owner decision, 2026-09-10) — set by the leader or an
  // officer (clans.service.ts's updateJoinRequirements), checked automatically
  // at join time. Joining is still open/unmoderated (no invite/request model,
  // see the enum comment above) — this only adds an automatic eligibility
  // filter on top of that, not an approval step. All default to "no
  // restriction" (0, or an empty allowedRaces array) so existing clans are
  // unaffected until a leader/officer opts in. The 4 attribute minimums check
  // the player's raw Core Attribute points (Player.baseDamage/baseDefense/
  // baseHp/baseEvasion) — equipment is deliberately excluded, same reasoning
  // as ClanWar's pool snapshot: gear is swappable at will, points are not.
  joinMinLevel     Int    @default(0)
  joinMinDamage    Int    @default(0)
  joinMinDefense   Int    @default(0)
  joinMinHp        Int    @default(0)
  joinMinEvasion   Int    @default(0)
  joinAllowedRaces Race[] @default([])

  // Emblem (owner decision, 2026-10-21): image numbers + palette keys
  // (GAME_BALANCE.clanEmblem); a random one is set when the clan is created.
  emblemShape       Int       @default(1)
  emblemSymbol      Int       @default(1)
  emblemBgColor     String    @default("darkblue")
  emblemSymbolColor String    @default("gold")
  // Last change by the leader; null = never changed (the random start).
  emblemChangedAt   DateTime?

  members        ClanMembership[]
  buildings      ClanBuilding[]
  messages       ClanMessage[]
  coreScores     ClanCoreScore[]
  reports        PlayerReport[]
  seasonResults  SeasonClanResult[]
  warsAsAttacker ClanWar[]          @relation("ClanWarsAsAttacker")
  warsAsDefender ClanWar[]          @relation("ClanWarsAsDefender")

  @@map("clans")
}

// Clan buildings are funded entirely from the treasury (never a member's own
// resources) and upgradable only by the leader or an officer — mirrors the
// personal BuildingType/BuildingLevelCost/PlayerBuilding pattern exactly.
// Three buildings, all placeholders (instructions/OPEN_DECISIONS.md: "clan
// building list" is UNDEFINED): Member Hall raises the effective member cap
// (bonusPerLevel is a flat slot count, not a percentage); Clan Forge adds a
// combat attack/defense bonus for every member (pve/combat.service.ts); Clan
// Depot adds a Metal/Crystal production bonus for every member
// (player/economy.service.ts) — both applied on top of that member's own
// personal research bonus, read via player/clan-bonus.service.ts.
enum ClanBuildingBonusType {
  MEMBER_CAPACITY
  COMBAT_BONUS
  PRODUCTION_BONUS
  // Tavern (owner decision, 2026-10-12): +damage vs bosses and the Core only
  // (Clan Forge stays the general-purpose combat bonus). Applies only while
  // ClanBuilding.activeUntil is in the future — see clans/clan-tavern.ts.
  BOSS_CORE_DAMAGE
  // Generator (owner decision, 2026-10-14): faster Action Energy regeneration
  // for every member, plus +1 max energy at GAME_BALANCE.clanGenerator levels.
  // Adds to the personal Reactor.
  ENERGY_REGEN
}

model ClanBuildingType {
  id             String                @id @default(uuid())
  key            String                @unique
  nameKey        String
  descriptionKey String
  bonusType      ClanBuildingBonusType
  bonusPerLevel  Float
  maxLevel       Int
  iconAssetId    String

  levelCosts    ClanBuildingLevelCost[]
  clanBuildings ClanBuilding[]

  @@map("clan_building_types")
}

model ClanBuildingLevelCost {
  id                  String @id @default(uuid())
  clanBuildingTypeId  String
  level               Int
  metalCost           Int
  crystalCost         Int
  creditsCost         Int
  constructionSeconds Int

  clanBuildingType ClanBuildingType @relation(fields: [clanBuildingTypeId], references: [id])

  @@unique([clanBuildingTypeId, level])
  @@map("clan_building_level_costs")
}

model ClanBuilding {
  id                 String    @id @default(uuid())
  clanId             String
  clanBuildingTypeId String
  level              Int       @default(0)
  constructionEndsAt DateTime?
  // Only meaningful for activatable buildings (the Tavern, BOSS_CORE_DAMAGE).
  // Null or in the past = inactive. Set to now + GAME_BALANCE.clanTavern.
  // activationHours by a manual (paid) activation; never renewed automatically.
  activeUntil        DateTime?

  clan             Clan             @relation(fields: [clanId], references: [id])
  clanBuildingType ClanBuildingType @relation(fields: [clanBuildingTypeId], references: [id])

  @@unique([clanId, clanBuildingTypeId])
  @@map("clan_buildings")
}

model ClanMembership {
  id       String   @id @default(uuid())
  clanId   String
  playerId String   @unique
  role     ClanRole @default(MEMBER)
  joinedAt DateTime @default(now())

  // Lifetime donations by this member while in THIS clan membership —
  // resets on leaving/rejoining, a placeholder for "contribution rules"
  // (instructions/OPEN_DECISIONS.md), not a final ranking formula.
  contributedMetal   Int @default(0)
  contributedCrystal Int @default(0)
  contributedCredits Int @default(0)

  clan   Clan   @relation(fields: [clanId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@map("clan_memberships")
}

// Clan chat (owner decision: clan-only, not open player-to-player DMs — a
// clan's membership is a bounded, already-cooperating audience with much
// lower abuse risk). Plain text, max length and per-player send-rate enforced
// server-side (game-config.ts's clanChat block). Only the most recent
// historyLimit messages are ever returned — no pagination/archival system,
// no deletion job; older rows just aren't queried.
model ClanMessage {
  id        String   @id @default(uuid())
  clanId    String
  playerId  String
  text      String
  createdAt DateTime @default(now())

  clan   Clan   @relation(fields: [clanId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@index([clanId, createdAt])
  @@map("clan_messages")
}

// Clan-vs-clan war (owner decision, 2026-09-10 — instructions/OPEN_DECISIONS.md's
// "clan-vs-clan war systems" was previously deliberately out of scope). One
// active war per clan at a time. Declared unilaterally by the attacking
// clan's leader/officer (mirrors kickMember/upgradeClanBuilding's role gate)
// — this immediately puts BOTH clans in a mutual "at war" state; the
// defending clan does not need to declare back (matches how regular PvP
// already works: the attacker initiates, the defender responds by fighting
// back on their own terms). Both clans need at least
// GAME_BALANCE.clanWar.minMembersToParticipate members to declare or be
// targeted — a flat floor, not a power-ratio matchmaking system, deliberately
// at the same rough level of "unsolved" as regular PvP's own undefined power
// range (instructions/OPEN_DECISIONS.md: PvP).
//
// attacker/defenderPoolMax are a snapshot taken at declaration time — sum of
// every current member's basePlayerHp + baseHp×hpPointValue (GEAR
// EXCLUDED on purpose: equipment is swappable at will, attribute points are
// not, see game-config.ts's clanWar comment) × GAME_BALANCE.clanWar.poolMultiplier.
// Every individual ClanWarAttack subtracts its raw damageDealt from the
// defending side's *current* pool, regardless of whether that one duel was
// individually won or lost (draining is damage-based, not win-based) — see
// clan-wars.service.ts. The war ends the moment either pool hits 0
// (ClanWarOutcome.CONQUEST) or endsAt passes first (CONQUEST if a pool
// happened to hit 0 in that same lazy check, otherwise DECISION for whoever
// has more remaining pool, or DRAW on an exact tie — e.g. nobody attacked at
// all, the "hypothetically nobody attacks" edge case the owner flagged).
// Resolution is checked lazily (elapsed-time, same pattern as buildings/
// research/expeditions/bosses) — never attack-triggered only, so a war with
// zero attacks still closes itself out at the deadline instead of staying
// open forever.
model ClanWar {
  id             String        @id @default(uuid())
  attackerClanId String
  defenderClanId String
  status         ClanWarStatus @default(ACTIVE)
  startedAt      DateTime      @default(now())
  endsAt         DateTime
  resolvedAt     DateTime?

  attackerPoolMax       Int
  attackerPoolRemaining Int
  defenderPoolMax       Int
  defenderPoolRemaining Int

  outcome      ClanWarOutcome?
  winnerClanId String?

  // Amount actually transferred from the loser's treasury to the winner's at
  // resolution (GAME_BALANCE.clanWar.conquestTreasuryStealPercentage/
  // decisionTreasuryStealPercentage of the loser's treasury at that moment,
  // 0 on a DRAW) — stored rather than recomputed later, since treasuries keep
  // changing after the war and the historical amount couldn't otherwise be
  // reconstructed. Always 0 while the war is still ACTIVE.
  treasuryMetalTransferred   Int @default(0)
  treasuryCrystalTransferred Int @default(0)
  treasuryCreditsTransferred Int @default(0)

  attackerClan Clan            @relation("ClanWarsAsAttacker", fields: [attackerClanId], references: [id])
  defenderClan Clan            @relation("ClanWarsAsDefender", fields: [defenderClanId], references: [id])
  attacks      ClanWarAttack[]

  @@index([attackerClanId, status])
  @@index([defenderClanId, status])
  @@map("clan_wars")
}

// One individual player-vs-player duel within a ClanWar — same round-by-round
// combat resolution as PvP (pve/combat.service.ts's simulate()), and the same
// resource-steal-on-win reward (GAME_BALANCE.pvp.resourceStealPercentage,
// reused rather than duplicated — owner decision). Two independent cooldowns,
// both owner-specified and modeled directly on PvP's existing
// pvpProtectedUntil/attackCooldownMinutes precedent: a defender who was just
// hit is protected from ANY attacker for clanWar.targetProtectionMinutes
// (Player.clanWarProtectedUntil), and the same attacker specifically cannot
// re-hit the same defender for clanWar.attackCooldownMinutes (checked by
// querying this table directly, same pattern as PvpService.isEligibleOpponent).
model ClanWarAttack {
  id            String        @id @default(uuid())
  clanWarId     String
  attackerId    String
  defenderId    String
  outcome       BattleOutcome
  rounds        Json
  attackerMaxHp Int
  defenderMaxHp Int
  damageDealt   Int
  damageTaken   Int
  lootSummary   Json
  createdAt     DateTime      @default(now())

  clanWar  ClanWar @relation(fields: [clanWarId], references: [id])
  attacker Player  @relation("ClanWarAttacksAsAttacker", fields: [attackerId], references: [id])
  defender Player  @relation("ClanWarAttacksAsDefender", fields: [defenderId], references: [id])

  @@index([clanWarId])
  @@index([attackerId, defenderId, createdAt])
  @@map("clan_war_attacks")
}

// Site staff accounts (owner decision, 2026-09-12) — deliberately NOT part of
// the Player model. An admin/moderator isn't a game character (no race,
// level, resources), and keeping this fully separate means a bug or bulk
// operation touching Player rows can never accidentally affect staff access,
// and adding a lower-privilege role (e.g. MODERATOR) later is just a new row
// with a different role, not a schema change to the player table. Logs in
// via its own endpoint/JWT (distinct secret from player tokens, distinct
// guard) at a deliberately unlinked URL — see apps/web/src/app/godmaster/.
enum AdminRole {
  ADMIN
  MODERATOR
}

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  // Owner decision (2026-10-12): staff accounts are deactivated, never
  // deleted (keeps the action log readable). Checked on every request by
  // AdminJwtStrategy, together with tokenVersion — bumping it (new password,
  // deactivation, role change) instantly invalidates every token already
  // issued for this account, which is what makes long-lived admin sessions safe.
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(0)

  actionLogs AdminActionLog[]

  @@map("admin_users")
}

enum AdminActionType {
  GRANT_RESOURCE
  GRANT_ITEM
  BAN_PLAYER
  UNBAN_PLAYER
  RENAME_PLAYER
