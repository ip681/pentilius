// Milestone 1: single-player vertical slice (base, buildings, ship/equipment,
// inventory, zones, PvE, XP/level, loot, item upgrade, battle reports).
// Static definitions vs. player state split per instructions/ARCHITECTURE.md.
//
// Several fields here stand in for values marked UNDEFINED in
// instructions/GAME_SYSTEMS.md / instructions/OPEN_DECISIONS.md (XP curve,
// land unlock thresholds, combat stats, upgrade costs). They are seeded data
// (LevelThreshold, Zone.unlockLevel, BuildingLevelCost, ItemDefinition) or
// constants in src/config/game-config.ts — never hard-coded in game logic —
// so the real values can be tuned later without touching code. See
// instructions/OPEN_DECISIONS.md for the list of what is still placeholder.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EquipmentSlot {
  WEAPON
  ENGINE
  HULL
  SHIELD
  REACTOR
  UTILITY
}

enum ResourceType {
  METAL
  CRYSTAL
  OXYGEN
  CREDITS
  UPGRADE_STONES
}

enum BattleOutcome {
  WIN
  LOSS
}

// Names and lore are LOCKED (instructions/PRODUCT_SPEC.md). Chosen once at
// registration; identity only for now — no stat bonus is tied to race yet
// (instructions/OPEN_DECISIONS.md).
enum Race {
  LUXARI
  VORLUN
  ZARYTH
  THALION
  NEXAR
}

model Player {
  id           String   @id @default(uuid())
  email        String   @unique
  // Public in-game identity. The email stays private to the account owner —
  // never exposed to other players — and is reserved for future account
  // verification (instructions/OPEN_DECISIONS.md has no ruling on this yet,
  // so treat it as owner-specified: username is the only cross-player identity).
  username     String   @unique
  passwordHash String
  race         Race
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  level Int @default(1)
  xp    Int @default(0)

  // Starting amounts are placeholders (instructions/OPEN_DECISIONS.md: "final resource list").
  metal              Int      @default(500)
  crystal            Int      @default(100)
  oxygen             Int      @default(100)
  credits            Int      @default(50)
  upgradeStones      Int      @default(5)
  resourcesUpdatedAt DateTime @default(now())

  // 10 is instructions/GAME_SYSTEMS.md's own example standard max, not an invented value.
  actionEnergy    Int      @default(10)
  actionEnergyMax Int      @default(10)
  energyUpdatedAt DateTime @default(now())

  buildings              PlayerBuilding[]
  items                  ItemInstance[]
  battleReports          BattleReport[]
  expeditions            PlayerExpedition[]
  researches             PlayerResearch[]
  bossEncounterEntries   BossEncounterParticipant[]

  @@map("players")
}

model Zone {
  id          String @id @default(uuid())
  key         String @unique
  nameKey     String
  order       Int
  unlockLevel Int

  pentili       Pentili[]
  battleReports BattleReport[]
  bosses        Boss[]

  @@map("zones")
}

model Pentili {
  id          String @id @default(uuid())
  key         String @unique
  nameKey     String
  zoneId      String
  level       Int
  maxHp       Int
  attack      Int
  defense     Int
  xpReward    Int
  iconAssetId String

  zone          Zone           @relation(fields: [zoneId], references: [id])
  lootDrops     LootDrop[]
  battleReports BattleReport[]

  @@map("pentili")
}

model LootDrop {
  id               String        @id @default(uuid())
  pentiliId        String
  resourceType     ResourceType?
  itemDefinitionId String?
  dropChance       Float
  minQuantity      Int
  maxQuantity      Int

  pentili        Pentili         @relation(fields: [pentiliId], references: [id])
  itemDefinition ItemDefinition? @relation(fields: [itemDefinitionId], references: [id])

  @@map("loot_drops")
}

model BuildingType {
  id          String @id @default(uuid())
  key         String @unique
  nameKey     String
  maxLevel    Int
  iconAssetId String

  levelCosts      BuildingLevelCost[]
  playerBuildings PlayerBuilding[]

  @@map("building_types")
}

model BuildingLevelCost {
  id                   String        @id @default(uuid())
  buildingTypeId       String
  level                Int
  metalCost            Int
  crystalCost          Int
  constructionSeconds  Int
  producesResourceType ResourceType?
  producesPerHour      Int?

  buildingType BuildingType @relation(fields: [buildingTypeId], references: [id])

  @@unique([buildingTypeId, level])
  @@map("building_level_costs")
}

model ItemDefinition {
  id              String        @id @default(uuid())
  key             String        @unique
  nameKey         String
  descriptionKey  String
  slot            EquipmentSlot
  // Flexible bag, not fixed columns: exact stat schema is UNDEFINED
  // (instructions/OPEN_DECISIONS.md: "final slot list"). M1 reads
  // attack/defense/hp keys from it — see pve/combat.service.ts.
  baseStats       Json
  maxUpgradeLevel Int
  iconAssetId     String
  isStarterItem   Boolean       @default(false)

  itemInstances   ItemInstance[]
  lootDrops       LootDrop[]
  bossLootDrops   BossLootDrop[]
  expeditionTypes ExpeditionType[]

  @@map("item_definitions")
}

model LevelThreshold {
  level      Int @id
  xpRequired Int

  @@map("level_thresholds")
}

model PlayerBuilding {
  id                 String    @id @default(uuid())
  playerId           String
  buildingTypeId     String
  level              Int       @default(0)
  constructionEndsAt DateTime?

  player       Player       @relation(fields: [playerId], references: [id])
  buildingType BuildingType @relation(fields: [buildingTypeId], references: [id])

  @@unique([playerId, buildingTypeId])
  @@map("player_buildings")
}

model ItemInstance {
  id               String         @id @default(uuid())
  playerId         String
  itemDefinitionId String
  upgradeLevel     Int            @default(0)
  equippedSlot     EquipmentSlot?
  acquiredAt       DateTime       @default(now())

  player         Player         @relation(fields: [playerId], references: [id])
  itemDefinition ItemDefinition @relation(fields: [itemDefinitionId], references: [id])

  @@map("item_instances")
}

model BattleReport {
  id            String        @id @default(uuid())
  playerId      String
  pentiliId     String
  zoneId        String
  outcome       BattleOutcome
  xpGained      Int
  lootSummary   Json
  damageDealt   Int
  damageTaken   Int
  rounds        Json
  playerMaxHp   Int
  pentiliMaxHp  Int
  createdAt     DateTime      @default(now())

  player  Player  @relation(fields: [playerId], references: [id])
  pentili Pentili @relation(fields: [pentiliId], references: [id])
  zone    Zone    @relation(fields: [zoneId], references: [id])

  @@map("battle_reports")
}

// Durations and rewards are PROVISIONAL (instructions/GAME_SYSTEMS.md:
// "Timed automatic missions such as 1h/5h/10h... Exact values are
// UNDEFINED"). 60/300/600 minutes are the doc's own example, not invented.
model ExpeditionType {
  id                    String   @id @default(uuid())
  key                   String   @unique
  nameKey               String
  durationMinutes       Int
  metalReward           Int
  crystalReward         Int
  creditsReward         Int
  xpReward              Int
  bonusItemDefinitionId String?
  bonusItemChance       Float?

  bonusItemDefinition ItemDefinition?    @relation(fields: [bonusItemDefinitionId], references: [id])
  playerExpeditions   PlayerExpedition[]

  @@map("expedition_types")
}

model PlayerExpedition {
  id               String    @id @default(uuid())
  playerId         String
  expeditionTypeId String
  startedAt        DateTime  @default(now())
  endsAt           DateTime
  claimedAt        DateTime?
  cancelled        Boolean   @default(false)

  player         Player         @relation(fields: [playerId], references: [id])
  expeditionType ExpeditionType @relation(fields: [expeditionTypeId], references: [id])

  @@map("player_expeditions")
}

// Branches, technology list, costs and effects are UNDEFINED
// (instructions/OPEN_DECISIONS.md: "Research"). This is a working mechanism
// with placeholder content, mirroring the building-upgrade pattern — each
// technology has its own independent timer, several can research in
// parallel. Bonuses are applied where noted: EconomyService.settleResources
// (production types) and CombatService.computePlayerStats (combat types).
enum ResearchBonusType {
  METAL_PRODUCTION
  CRYSTAL_PRODUCTION
  COMBAT_ATTACK
  COMBAT_HP
}

model ResearchType {
  id             String            @id @default(uuid())
  key            String            @unique
  nameKey        String
  descriptionKey String
  bonusType      ResearchBonusType
  bonusPerLevel  Float
  maxLevel       Int
  iconAssetId    String

  levelCosts       ResearchLevelCost[]
  playerResearches PlayerResearch[]

  @@map("research_types")
}

model ResearchLevelCost {
  id              String @id @default(uuid())
  researchTypeId  String
  level           Int
  metalCost       Int
  crystalCost     Int
  creditsCost     Int
  researchSeconds Int

  researchType ResearchType @relation(fields: [researchTypeId], references: [id])

  @@unique([researchTypeId, level])
  @@map("research_level_costs")
}

model PlayerResearch {
  id             String    @id @default(uuid())
  playerId       String
  researchTypeId String
  level          Int       @default(0)
  researchEndsAt DateTime?

  player       Player       @relation(fields: [playerId], references: [id])
  researchType ResearchType @relation(fields: [researchTypeId], references: [id])

  @@unique([playerId, researchTypeId])
  @@map("player_researches")
}

// Boss Hunts (instructions/GAME_SYSTEMS.md, LOCKED direction): group size,
// attempts, loot, boss timers and contribution calculation are UNDEFINED
// (instructions/OPEN_DECISIONS.md). Since clans (Milestone 4) don't exist
// yet, joining is an open lobby per zone rather than an invite system: any
// player with the zone unlocked may freely join a boss's current OPEN
// encounter while its join window is running. Resolution combines every
// joined player's combat stats (pve/combat.service.ts) plus the LOCKED
// racial-synergy bonus (instructions/GAME_SYSTEMS.md) into one party vs. the
// boss, then splits rewards by each player's share of total party attack —
// a clearly-isolated placeholder for "contribution calculation".
enum BossEncounterStatus {
  OPEN
  RESOLVED
}

model Boss {
  id                     String @id @default(uuid())
  key                    String @unique
  nameKey                String
  zoneId                 String
  level                  Int
  maxHp                  Int
  attack                 Int
  defense                Int
  xpReward               Int
  encounterWindowSeconds Int
  iconAssetId            String

  zone       Zone            @relation(fields: [zoneId], references: [id])
  lootDrops  BossLootDrop[]
  encounters BossEncounter[]

  @@map("bosses")
}

model BossLootDrop {
  id               String        @id @default(uuid())
  bossId           String
  resourceType     ResourceType?
  itemDefinitionId String?
  dropChance       Float
  minQuantity      Int
  maxQuantity      Int

  boss           Boss            @relation(fields: [bossId], references: [id])
  itemDefinition ItemDefinition? @relation(fields: [itemDefinitionId], references: [id])

  @@map("boss_loot_drops")
}

model BossEncounter {
  id           String               @id @default(uuid())
  bossId       String
  status       BossEncounterStatus  @default(OPEN)
  openedAt     DateTime             @default(now())
  resolvesAt   DateTime
  outcome      BattleOutcome?
  rounds       Json?
  partyMaxHp   Int?
  bossMaxHp    Int?

  boss         Boss                       @relation(fields: [bossId], references: [id])
  participants BossEncounterParticipant[]

  @@map("boss_encounters")
}

model BossEncounterParticipant {
  id                String   @id @default(uuid())
  encounterId       String
  playerId          String
  joinedAt          DateTime @default(now())
  contributionShare Float?
  xpGained          Int?
  lootSummary       Json?

  encounter BossEncounter @relation(fields: [encounterId], references: [id])
  player    Player        @relation(fields: [playerId], references: [id])

  @@unique([encounterId, playerId])
  @@map("boss_encounter_participants")
}
