// Milestone 0: only the player identity needed for auth.
// Game entities (resources, buildings, ship, inventory, items) arrive in Milestone 1,
// as static definitions vs. player-state tables per instructions/ARCHITECTURE.md.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("players")
}
