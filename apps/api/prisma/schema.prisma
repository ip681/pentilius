}

// Audit trail for every godmaster mutation (owner decision, 2026-09-12) —
// built as the foundation for the unified player-lookup detail view before
// ban/rename themselves. targetUsername is a denormalized snapshot (not just
// a join through targetPlayerId) so a rename's own log entry still reads
// correctly, and so history survives even if the player relation is ever
// nulled out. details is a free-form JSON bag (amount, resourceType, itemKey,
// oldUsername/newUsername, banHours/reason, etc.) — one shape per actionType,
// not a fixed column set, same "flexible bag" reasoning as ItemDefinition.baseStats.
model AdminActionLog {
  id             String          @id @default(uuid())
  adminId        String
  adminUsername  String
  actionType     AdminActionType
  targetPlayerId String?
  targetUsername String?
  details        Json
  createdAt      DateTime        @default(now())

  admin  AdminUser @relation(fields: [adminId], references: [id])
  target Player?   @relation(fields: [targetPlayerId], references: [id], onDelete: SetNull)

  @@index([targetPlayerId])
  @@map("admin_action_logs")
}

// Seasons and the Core (owner decision, 2026-10-12 — replaces the earlier
// "clans build the Core" concept). The Core is not built: once it opens,
// any clan member may attack it (1 Action Energy per attack) and every point
// of damage dealt is credited to their clan's ClanCoreScore for this season.
// After coreDurationDays the clan with the most damage wins. Both values are
// set from the godmaster Settings tab and lock once coreOpensAt passes —
// neither can be changed (or postponed) after the Core has opened.
// The current season is simply the row with the highest id.
model Season {
  id               Int       @id @default(autoincrement())
  coreOpensAt      DateTime?
  coreDurationDays Int       @default(14)
  // Set once the Core window has closed and SeasonClanResult rows were
  // snapshotted (lazily, on the first read after the deadline).
  finalizedAt      DateTime?
  // Set when this season was wiped and the next one created (owner decision,
  // 2026-10-13) — GameSettings.seasonResetDelayDays after the Core closes, or
  // earlier via godmaster's "reset now". Null = not reset yet.
  resetAt          DateTime?
  createdAt        DateTime  @default(now())

  clanScores    ClanCoreScore[]
  coreAttacks   CoreAttack[]
  clanResults   SeasonClanResult[]
  playerResults SeasonPlayerResult[]

  @@map("seasons")
}

// Live per-clan damage total for one season — what the sliders read.
// BigInt because a whole clan's 14-day total can exceed a 32-bit Int.
// updatedAt doubles as the tie-break: on equal damage, whoever reached the
// total first (older updatedAt) ranks higher.
model ClanCoreScore {
  id        String   @id @default(uuid())
  seasonId  Int
  clanId    String
  damage    BigInt   @default(0)
  updatedAt DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id])
  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([seasonId, clanId])
  @@index([seasonId, damage])
  @@map("clan_core_scores")
}

// One Core attack. clanId is a plain snapshot (not a relation) — points stay
// with the clan the player was in at attack time even if they later leave
// (owner decision), and the row survives the clan being disbanded.
model CoreAttack {
  id          String   @id @default(uuid())
  seasonId    Int
  playerId    String
  clanId      String
  damageDealt Int
  damageTaken Int
  rounds      Json
  playerMaxHp Int
  createdAt   DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id])
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([seasonId, clanId])
  @@index([playerId, createdAt])
  @@map("core_attacks")
}

// Final standings snapshot, written once when the season's Core window
// closes — kept forever so a player's profile can show where their clan
// finished in past seasons. Name/tag are denormalized so history survives
// renames and disbanding (clanId is then nulled).
model SeasonClanResult {
  id       String  @id @default(uuid())
  seasonId Int
  clanId   String?
  clanName String
  clanTag  String
  rank     Int
  damage   BigInt

  season Season @relation(fields: [seasonId], references: [id])
  clan   Clan?  @relation(fields: [clanId], references: [id], onDelete: SetNull)

  @@unique([seasonId, rank])
  @@index([clanId])
  @@map("season_clan_results")
}

// Player blocking (owner decision, 2026-10-12 — app-store UGC requirement).
// One-directional: the blocker stops seeing the blocked player's clan-chat
// messages, and the two can't be friends (so no DMs, no friend requests) —
// creating a block deletes any friendship/request between them. Gameplay
// (PvP, wars, market, rankings) is deliberately unaffected. The blocked
// player is never told; their attempts just fail with a generic error.
model PlayerBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker Player @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Player @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("player_blocks")
}

enum ReportTargetType {
  PLAYER
  CLAN
  CLAN_MESSAGE
  DIRECT_MESSAGE
}

enum ReportReason {
  HARASSMENT
  OFFENSIVE_CONTENT
  SPAM
  CHEATING
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Reports (owner decision, 2026-10-12 — app-store UGC requirement). A report
// never acts on its own — only a godmaster admin decides. Abuse limits (daily
// cap, cooldown, account age/level, auto-suspension after too many dismissed
// reports) live in GAME_BALANCE.moderation. contentSnapshot is captured by the
// SERVER at report time (message text, or name/bio/description), so the
// evidence survives later edits, renames or deletions.
// targetPlayerId = the reported player, or the author of a reported message;
// null for a reported clan. targetId = the reported entity's own id (player,
// clan or message) — used to stop duplicate open reports of the same thing.
model PlayerReport {
  id              String           @id @default(uuid())
  reporterId      String
  targetType      ReportTargetType
  targetId        String
  targetPlayerId  String?
  targetClanId    String?
  contentSnapshot String
  reason          ReportReason
  comment         String?
  status          ReportStatus     @default(OPEN)
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?
  resolvedByAdmin String?
  resolutionNote  String?

  reporter     Player  @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetPlayer Player? @relation("ReportsReceived", fields: [targetPlayerId], references: [id], onDelete: SetNull)
  targetClan   Clan?   @relation(fields: [targetClanId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetPlayerId])
  @@index([targetClanId])
  @@map("player_reports")
}

// Global, non-seasonal game settings editable from the godmaster Settings tab
// (owner decision, 2026-10-12). A single row, id = 1.
model GameSettings {
  id                       Int      @id @default(1)
  // Days between requesting account deletion and it actually happening.
  accountDeletionGraceDays Int      @default(3)
  // Days between the Core closing (season end) and the automatic season
  // reset — time for players to see the final standings (owner decision,
  // 2026-10-13). Also guarantees a nightly DB backup of the final state.
  seasonResetDelayDays     Int      @default(1)
  // Countries where real-money purchases are offered, comma-separated
  // (owner decision, 2026-10-15: Bulgaria first). Set in godmaster.
  paymentsAllowedCountries String   @default("BG")
  // The seller's details and the NRA e-shop data for the sale documents and
  // the monthly audit file (owner decision, 2026-10-23) — see SellerInfoDto.
  sellerInfo               Json?
  updatedAt                DateTime @updatedAt

  @@map("game_settings")
}

// Record of completed account deletions — the only place the old username is
// kept (for support/moderation questions), never shown to players. No FK: the
// anonymized Player row no longer carries the identity this row describes.
model AccountDeletionLog {
  id          String   @id @default(uuid())
  playerId    String
  username    String
  requestedAt DateTime
  completedAt DateTime @default(now())

  @@index([completedAt])
  @@map("account_deletion_logs")
}

// Content filter (owner decision, 2026-10-12 — app-store UGC requirement).
// Checked on usernames at registration, clan name/tag/description and player
// bios — not chat or DMs (reports and blocking cover those). Editable from the
// godmaster "Филтър" tab without a deploy. `normalized` is the word after the
// same normalization the checker applies to text (moderation/content-filter.ts),
// so matching is one comparison; `word` keeps what the moderator typed.
enum BannedWordMatch {
  // Only as a standalone word — for short words that also occur inside
  // innocent words.
  WHOLE_WORD
  // Anywhere, even glued to other letters — for long, unambiguous words.
  SUBSTRING
}

model BannedWord {
  id         String          @id @default(uuid())
  word       String
  normalized String          @unique
  match      BannedWordMatch @default(SUBSTRING)
  createdBy  String?
  createdAt  DateTime        @default(now())

  @@map("banned_words")
}

// A player's season, frozen when the Core closes (owner decision, 2026-10-13)
// and shown on their profile forever, e.g. "Season 1 · Luxari · #3 with
// [STI] Sim Titans (Officer) · Level 47 · Core: 184,520 damage (#12)". The
// clan is the one they were in AT THE END of the season (snapshotted then,
// not at the later reset, so a last-day clan switch can't claim a placement).
// Clan fields are null if they weren't in a clan; ranks are null when there's
// nothing to rank (clan/player dealt no Core damage).
model SeasonPlayerResult {
  id             String    @id @default(uuid())
  seasonId       Int
  playerId       String
  race           Race
  level          Int
  clanName       String?
  clanTag        String?
  clanRole       ClanRole?
  clanRank       Int?
  coreDamage     Int       @default(0)
  coreDamageRank Int?

  season Season @relation(fields: [seasonId], references: [id])
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([seasonId, playerId])
  @@index([playerId])
  @@map("season_player_results")
}

// Daily tasks (owner decision, 2026-10-13 — GAME_SYSTEMS.md "Daily tasks").
// The task list itself lives in GAME_BALANCE.dailyTasks (not godmaster-editable
// for now). `day` is the calendar day in Europe/Sofia ("2026-10-13") — tasks
// reset at 00:00 Bulgarian time. Progress is one counter per action type per
// day (every Pentili battle, PvP attack, finished expedition, boss-formation
// join, donated resource amount); several tasks can read the same counter
// (the 10 -> 15 -> 20 Pentili chain).
model DailyTaskProgress {
  id       String @id @default(uuid())
  playerId String
  day      String
  type     String
  count    Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, day, type])
  @@map("daily_task_progress")
}

// A claimed reward — one row per task per day (taskKey "ALL_DONE" for the
// all-tasks bonus). auto = granted automatically after the day ended because
// the player didn't press "Claim" in time (owner decision: never lost).
model DailyTaskClaim {
  id        String   @id @default(uuid())
  playerId  String
  day       String
  taskKey   String
  auto      Boolean  @default(false)
  claimedAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, day, taskKey])
  @@index([playerId, day])
  @@map("daily_task_claims")
}

// Season achievements and level rewards (owner decision, 2026-10-13). Counted
// metrics (Pentili wins, expeditions, ...) live here; state-based ones (best
// item upgrade, full set, building levels) are read live. Wiped by a season reset.
model AchievementProgress {
  id       String @id @default(uuid())
  playerId String
  metric   String
  count    Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, metric])
  @@map("achievement_progress")
}

// One row per claimed reward: an achievement tier ("pentili_wins_2") or a
// level reward ("level_12"). Claims are always manual (owner decision).
model AchievementClaim {
  id        String   @id @default(uuid())
  playerId  String
  key       String
  claimedAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, key])
  @@map("achievement_claims")
}

// "Contact the team" (owner decision, 2026-10-13). OPEN = waiting for staff
// (new, or the player wrote again), ANSWERED = staff replied, CLOSED = done.
enum SupportCategory {
  IDEA
  BUG
  QUESTION
  OTHER
}

enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

// One conversation. Kept across season resets; deleted with the account.
model SupportTicket {
  id           String          @id @default(uuid())
  playerId     String
  category     SupportCategory
  status       SupportStatus   @default(OPEN)
  // A staff reply the player hasn't opened yet — the dot on Settings.
  playerUnread Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  player   Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([status, updatedAt])
  @@index([playerId])
  @@map("support_tickets")
}

// The player sees staff messages as "the Pentilius team"; the author is kept
// (adminUsername is a snapshot) and shown only in godmaster.
model SupportMessage {
  id            String   @id @default(uuid())
  ticketId      String
  fromStaff     Boolean
  adminUserId   String?
  adminUsername String?
  text          String
  createdAt     DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// Web Push (owner decision, 2026-10-13): one row per browser/device that
// allowed notifications. Removed when the browser reports it gone (404/410),
// when the player turns push off, and with the account.
model PushSubscription {
  id        String   @id @default(uuid())
  playerId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("push_subscriptions")
}

// "Already sent" marks so the minute scan and event hooks never notify twice
// for the same thing. Pruned after two days.
model PushDispatch {
  id        String   @id @default(uuid())
  playerId  String
  type      String
  refKey    String
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, type, refKey])
  @@index([createdAt])
  @@map("push_dispatches")
}

enum EmailTokenType {
  VERIFY_EMAIL
  PASSWORD_RESET
}

// One-time links sent by email (owner decision, 2026-10-13). Only a SHA-256 of
// the token is stored; a token works once, until expiresAt.
model EmailToken {
  id        String         @id @default(uuid())
  playerId  String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, type, createdAt])
  @@map("email_tokens")
}

// ---------------------------------------------------------------------------
// Payments (owner decision, 2026-10-15). The game only knows its own products;
// each payment provider (Stripe now; App Store / Google Play later) is an
// adapter mapped to them. Rewards are granted only after the provider
// confirms, exactly once (unique provider reference).

enum PaymentProductKind {
  CREDITS
  VIP
}

enum PaymentProvider {
  STRIPE
  APP_STORE
  GOOGLE_PLAY
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELED
  REFUNDED
}

// What can be bought for real money — managed in godmaster (owner decision,
// 2026-10-17): names, what it grants, the Stripe price, on/off. The seed only
// creates the first rows and never overwrites them. Test and live Stripe price
// IDs differ, which is fine: local and production are separate databases.
model PaymentProduct {
  id              String             @id @default(uuid())
  key             String             @unique
  // Optional custom names (special offers). Empty = the name comes from a
  // translated template, e.g. "VIP for {days} days" (owner decision,
  // 2026-10-18), so a new product needs no typing in any language.
  nameBg          String?
  nameEn          String?
  // Stripe's product and current price (price_…), created from godmaster.
  // A price change makes a new Stripe price and archives the old one.
  // The product is offered only when a price is set.
  stripeProductId String?
  stripePriceId   String?            @unique
  kind            PaymentProductKind
  // What the purchase grants.
  credits         Int?
  vipDays         Int?
  // Shown price; the provider charges its own configured price.
  priceCents      Int
  currency        String             @default("eur")
  sortOrder       Int                @default(0)
  active          Boolean            @default(true)

  purchases Purchase[]

  @@map("payment_products")
}

// The purchases ledger — one row per checkout. providerRef is the provider's
// own ID (Stripe: the Checkout Session ID), unique per provider, so a repeated
// provider notification can never grant twice. Kept when an account is deleted
// (accounting); the player row itself is anonymized, not removed.
model Purchase {
  id          String          @id @default(uuid())
  playerId    String
  productId   String
  provider    PaymentProvider
  providerRef String
  status      PurchaseStatus  @default(PENDING)
  amountCents Int
  currency    String
  // What it granted at the time of purchase — a refund takes back exactly
  // this, even if the product was changed later.
  credits     Int?
  vipDays     Int?
  // Country from the player's IP when the checkout started, and the card's
  // country from the provider (a second check for the Bulgaria-only phase).
  ipCountry   String?
  cardCountry String?
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  refundedAt  DateTime?
  // Direct sale (we are the seller; sale documents + audit file) or through
  // Stripe Managed Payments (later; no documents from us until decided).
  paymentPath     PaymentPath @default(DIRECT)
  // Stripe's livemode: test payments get test documents, never in the audit file.
  livemode        Boolean     @default(false)
  // The reference number of the payment on the documents (Stripe PaymentIntent),
  // and the charge behind it.
  paymentIntentId String?
  chargeId        String?

  player  Player         @relation(fields: [playerId], references: [id])
  product PaymentProduct @relation(fields: [productId], references: [id])
  documents SaleDocument[]

  @@unique([provider, providerRef])
  @@index([playerId, createdAt])
  @@map("purchases")
}

// Balance settings edited in godmaster (owner decision, 2026-10-18 — balance
// is tuned from godmaster, not only in code). One JSON document per area;
// the code holds the defaults, and the seed never overwrites a saved one.
model BalanceConfig {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@map("balance_configs")
}

// Security record of logins (owner decision, 2026-10-19): only to spot
// multi-accounts and ban evasion, shown to staff in godmaster. Deleted after
// GAME_BALANCE.security.loginRetentionDays (90). See auth/login-events.service.ts.
model LoginEvent {
  id        String   @id @default(uuid())
  playerId  String
  createdAt DateTime @default(now())
  // LOGIN | REGISTER | REFRESH
  kind      String
  ip        String
  country   String?
  // DESKTOP | MOBILE | TABLET
  device    String?
  browser   String?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@index([ip])
  @@index([createdAt])
  @@map("login_events")
}

// Staff announcements (owner decision, 2026-10-21): a banner on every page
// between startsAt and endsAt. Texts per language ({ en, bg, ... }), English
// required and used when the player's language has none. `locales` limits who
// sees it; empty = everyone.
enum AnnouncementKind {
  INFO
  IMPORTANT
}

model Announcement {
  id        String           @id @default(uuid())
  kind      AnnouncementKind
  texts     Json
  locales   String[]
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  dismissals AnnouncementDismissal[]

  @@index([startsAt, endsAt])
  @@map("announcements")
}

// A player closed an announcement — kept on the server, so it stays closed on every device.
model AnnouncementDismissal {
  announcementId String
  playerId       String
  dismissedAt    DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  player       Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([announcementId, playerId])
  @@index([playerId])
  @@map("announcement_dismissals")
}

// Sales documents (owner decision, 2026-10-23; Наредба Н-18, чл. 52о): one per
// direct sale and one per refund, issued in the same transaction that completes
// or refunds the purchase. Never changed or deleted — a database trigger refuses
// both (migration 20261023120000_sale_documents). Each kind and mode (live/test)
// has its own gap-free 10-digit series (DocumentCounter). `seller` and the NRA
// numbers are a snapshot taken at issue, so later settings changes can't alter
// an issued document.
enum PaymentPath {
  DIRECT
  MOR
}

enum SaleDocumentKind {
  SALE
  REFUND
}

model SaleDocument {
  id             String           @id @default(uuid())
  kind           SaleDocumentKind
  number         BigInt
  test           Boolean
  purchaseId     String
  // A refund document points at the sale it reverses.
  saleDocumentId String?
  issuedAt       DateTime         @default(now())
  orderNumber    String
  transactionRef String
  chargeRef      String?
  seller         Json
  eshopNumber    String
  posNumber      String
  // [{ name, taxGroup, quantity, unitPriceCents, amountCents }]
  lines          Json
  totalCents     Int
  currency       String
  paymentMethod  String
  qrPayload      String

  purchase Purchase      @relation(fields: [purchaseId], references: [id])
  sale     SaleDocument? @relation("RefundOfSale", fields: [saleDocumentId], references: [id], onDelete: Restrict)
  refunds  SaleDocument[] @relation("RefundOfSale")

  @@unique([kind, test, number])
  @@unique([purchaseId, kind])
  @@index([test, issuedAt])
  @@map("sale_documents")
}

// The last number used per series ("SALE_LIVE", "SALE_TEST", "REFUND_LIVE",
// "REFUND_TEST"); taken with a row lock inside the issuing transaction, so a
// rolled-back purchase never uses up a number.
model DocumentCounter {
  key  String @id
  last BigInt @default(0)

  @@map("document_counters")
}

// Every monthly NRA audit file generated in godmaster (Приложение № 38), kept
// as the exact bytes downloaded (UTF-8).
model AuditFile {
  id            String   @id @default(uuid())
  year          Int
  month         Int
  createdAt     DateTime @default(now())
  adminId       String
  adminUsername String
  orderCount    Int
  refundCount   Int
  totalCents    Int
  xml           Bytes

  @@index([year, month])
  @@map("audit_files")
}
