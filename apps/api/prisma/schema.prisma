  RESET_ADMIN_PASSWORD
  DEACTIVATE_ADMIN
  ACTIVATE_ADMIN
  CHANGE_OWN_PASSWORD
  UPDATE_GAME_SETTINGS
  RESET_SEASON
  ADD_BANNED_WORD
  REMOVE_BANNED_WORD
  GRANT_VIP
  REVOKE_VIP
  SUPPORT_REPLY
  SUPPORT_CLOSE
  SUPPORT_REOPEN
  SET_PLAYER_PASSWORD
