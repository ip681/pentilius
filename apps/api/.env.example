# Copy to apps/api/.env — Nest (ConfigModule) and the Prisma CLI both read
# their working-directory .env when run via `npm run <script> -w apps/api`.
DATABASE_URL=postgresql://pentilius:pentilius@localhost:5432/pentilius?schema=public
PORT=3001
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d
# Deliberately separate secret from the player tokens above — AdminUser
# sessions are a fully independent auth system (see schema.prisma's
# AdminUser comment).
ADMIN_JWT_SECRET=change-me-admin
ADMIN_JWT_EXPIRES_IN=2h

# Web Push — generate once: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@pentilius.com
